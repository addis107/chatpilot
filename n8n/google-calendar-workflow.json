{
  "name": "ChatPilot — Google Calendar (availability + booking)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chatpilot-calendar",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Webhook — from ChatPilot",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 320],
      "webhookId": "chatpilot-calendar"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "availability.check",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Availability check?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [450, 320]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "returnAll": true,
        "timeMin": "={{ $json.body.date }}T00:00:00",
        "timeMax": "={{ $json.body.date }}T23:59:59",
        "options": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Get busy times",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [690, 220],
      "notes": "Connect your Google Calendar credential. Returns events on that day."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ busy: $input.all().map(i => ({ start: i.json.start, end: i.json.end, summary: i.json.summary })) }) }}",
        "options": {}
      },
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "Answer availability",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [930, 220]
    },
    {
      "parameters": {
        "operation": "create",
        "calendar": { "__rl": true, "mode": "list", "value": "primary" },
        "start": "={{ $json.body.isoStart || $json.body.requestedTime }}",
        "end": "={{ $json.body.isoEnd || $json.body.isoStart }}",
        "additionalFields": {
          "summary": "={{ $json.body.business }} — {{ $json.body.name }}",
          "attendeesUi": {
            "values": [{ "email": "={{ $json.body.email }}" }]
          },
          "description": "=Booked via ChatPilot. Requested: {{ $json.body.requestedTime }}. Ref: {{ $json.body.ref }}"
        }
      },
      "id": "e5555555-5555-4555-8555-555555555555",
      "name": "Create calendar event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [690, 440],
      "notes": "Creates the event and invites the customer (needs isoStart/isoEnd from the agent)."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": {}
      },
      "id": "f6666666-6666-4666-8666-666666666666",
      "name": "Answer booking",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [930, 440]
    }
  ],
  "connections": {
    "Webhook — from ChatPilot": {
      "main": [[{ "node": "Availability check?", "type": "main", "index": 0 }]]
    },
    "Availability check?": {
      "main": [
        [{ "node": "Get busy times", "type": "main", "index": 0 }],
        [{ "node": "Create calendar event", "type": "main", "index": 0 }]
      ]
    },
    "Get busy times": {
      "main": [[{ "node": "Answer availability", "type": "main", "index": 0 }]]
    },
    "Create calendar event": {
      "main": [[{ "node": "Answer booking", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {}
}
