{
  "name": "ChatPilot — Reply approval (Slack → email)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chatpilot-review",
        "options": {}
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Webhook — draft reply",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "chatpilot-review"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "reply.draft",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Only draft replies",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#chatpilot-approvals"
        },
        "message": "=✍️ *New reply to review* — {{ $json.body.business }}\n\n*Question:*\n{{ $json.body.question }}\n\n*Proposed reply (edit if needed):*\n{{ $json.body.draft }}\n\n*Will be emailed to:* {{ $json.body.customerEmail }}",
        "responseType": "freeText",
        "options": {
          "messageButtonLabel": "Approve & edit"
        }
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Approve / edit in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [720, 280],
      "notes": "Connect your Slack credential. Posts the draft and waits; the approver can edit the text before approving."
    },
    {
      "parameters": {
        "sendTo": "={{ $('Webhook — draft reply').item.json.body.customerEmail }}",
        "subject": "=Re: your question",
        "message": "={{ $json.data.text || $('Webhook — draft reply').item.json.body.draft }}",
        "options": {}
      },
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "Email the customer",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [980, 280],
      "notes": "Connect your Gmail (or swap for SMTP/SendGrid). Sends the approved/edited reply to the customer."
    }
  ],
  "connections": {
    "Webhook — draft reply": {
      "main": [[{ "node": "Only draft replies", "type": "main", "index": 0 }]]
    },
    "Only draft replies": {
      "main": [[{ "node": "Approve / edit in Slack", "type": "main", "index": 0 }]]
    },
    "Approve / edit in Slack": {
      "main": [[{ "node": "Email the customer", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {}
}
