# Copy this file to ".env" and fill in the values.

# Local database (SQLite). No setup needed — the file is created automatically.
DATABASE_URL="file:./dev.db"

# Your Anthropic API key — powers the AI agent. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The public URL where this app runs (used to build the embed snippet).
NEXT_PUBLIC_APP_URL=http://localhost:3000
